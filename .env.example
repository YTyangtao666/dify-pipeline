# ============ 中转站(生图+VLM+LLM) ============
# 本项目实际用的中转站是 yunwu.ai（OpenAI 兼容协议）
ARK_BASE_URL=https://yunwu.ai/v1
ARK_API_KEY=sk-xxxxxxxxxxxxxxxx
# yunwu.ai 在国内需走本地代理
ARK_PROXY=http://127.0.0.1:7897

# 模型名以中转站后台 /v1/models 列表为准
IMAGE_MODEL=qwen-image-2.0-2026-03-03
VLM_MODEL=gemini-3.5-flash
LLM_MODEL=deepseek-v3.2

# ============ 本地 FastAPI 服务 ============
API_HOST=127.0.0.1
API_PORT=8100

# ============ TTS ============
TTS_VOICE=zh-CN-XiaoxiaoNeural
